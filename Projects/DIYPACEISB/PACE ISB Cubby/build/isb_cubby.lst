  1237                           	psect	code
  1238     0005                     main:	
  1239                           ; Interrupts not implemented
  1240                           ;-------------------------------------------------
  1241                           ; User code
  1242                           ;-------------------------------------------------
  1243                           
  1244     0005  1303 1683          	banksel	143
  1245     0007  3070               	movlw	112
  1246     0008  048F               	iorwf	143,f	; Configure 8 MHz operation
  1247     0009  1303 1683          	banksel	133
  1248     000B  1385               	bcf	133,7	; ((PORTA) and 07Fh), 7 = sensor pin
  1249     000C  1186               	bcf	134,3	; ((PORTB) and 07Fh), 3 = onboard LED
  1250     000D  1306               	bcf	134,6	; ((PORTB) and 07Fh), 6 = UART debug output
  1251     000E  1386               	bcf	134,7	; ((PORTB) and 07Fh), 7 = ISB cubby output
  1252     000F  019B               	clrf	155	; ANSEL is same bank as TRISA
  1253     0010  1303 1283          	banksel	5
  1254     0012  1785               	bsf	5,7	; Discharge capacitor on sensor pin when configured as an output
  1255     0013  1386               	bcf	6,7	; Default is soldering iron is in the holder
  1256     0014                     loop:
  1257     0014  1303 1283          	banksel	35	; Debugging
  1258     0016  0823               	movf	35,w
  1259     0017  00A2               	movwf	34
  1260     0018  2050               	call	uart_tx
  1261     0019  01A3               	clrf	35
  1262     001A  1303 1683          	banksel	133
  1263     001C  1385               	bcf	133,7	; Sensor pin output
  1264     001D  1303 1283          	banksel	5
  1265     001F  1785               	bsf	5,7	; Set pin output state
  1266     0020  2040               	call	dsensor	; Wait to discharge capacitor
  1267     0021  1303 1683          	banksel	133
  1268     0023  1785               	bsf	133,7	; Sensor pin input
  1269     0024  1303 1283          	banksel	35
